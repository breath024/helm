/* HELM 프론트 — 패널마다 xterm 1개 + 웹소켓 1개.
   패널의 DOM은 한 번만 만들고, 분할이 바뀌면 슬롯으로 옮겨 끼운다.
   (다시 만들면 화면 내용이 날아가므로) */

const $ = (s) => document.querySelector(s);
const panes = new Map();     // id -> pane
let order = [];              // 탭 순서
let layout = 1;
let slots = [null];
let focusSlot = 0;
let models = [], efforts = [], projects = [], permModes = [];
let curModel = "claude-opus-5", curEffort = "high", curPerm = "manual";
let allSessions = [];
let usage = {};              // 패널 id -> {tokens, limit, pct}

const permOf = (id) => permModes.find((p) => p.id === id);

const modelOf = (id) => models.find((m) => m.id === id);
const takesEffort = (id) => { const m = modelOf(id); return m ? !!m.effort : true; };

/** 같은 계열끼리 묶어 <optgroup>으로 그린다 */
function modelOptions(sel) {
  const fams = [...new Set(models.map((m) => m.family || "기타"))];
  return fams.map((f) => `<optgroup label="${esc(f)}">` + models
    .filter((m) => (m.family || "기타") === f)
    .map((m) => `<option value="${esc(m.id)}" ${m.id === sel ? "selected" : ""}>${esc(m.label)}</option>`)
    .join("") + `</optgroup>`).join("");
}

function effortButtons(sel) {
  return efforts.map((e) => `<button data-e="${e}" class="${e === sel ? "on" : ""}">${e}</button>`).join("");
}

const TERM_THEME = {
  background: "#131318", foreground: "#dcdce4", cursor: "#e0a672",
  cursorAccent: "#131318", selectionBackground: "#3a4a66",
  black: "#2a2a33", red: "#e5766f", green: "#7fc9a0", yellow: "#dfb673",
  blue: "#7fa8dc", magenta: "#bf8fd0", cyan: "#72c0c5", white: "#cdcdd8",
  brightBlack: "#55555f", brightRed: "#f29088", brightGreen: "#9adfb6",
  brightYellow: "#f2cd85", brightBlue: "#9cc0ea", brightMagenta: "#d3a8e2",
  brightCyan: "#8dd6db", brightWhite: "#eeeef5",
};

const TERM_OPTS = {
  theme: TERM_THEME,
  fontFamily: `"JBM","Cascadia Code","Malgun Gothic",Consolas,monospace`,
  fontSize: 13.5,
  lineHeight: 1.35,
  letterSpacing: 0.2,
  cursorBlink: true,
  cursorStyle: "bar",
  cursorWidth: 2,
  scrollback: 8000,
  smoothScrollDuration: 90,
  allowProposedApi: true,
  drawBoldTextInBrightColors: false,
  minimumContrastRatio: 1,
};

// ============================== 부팅 ==============================
async function boot() {
  const b = await (await fetch("/api/bootstrap")).json();
  projects = b.projects; models = b.models; efforts = b.efforts;
  permModes = b.perm_modes || [];
  curModel = b.last_model || "claude-opus-5";
  curEffort = b.last_effort || "high";
  curPerm = b.last_perm_mode || "manual";
  if (!modelOf(curModel)) curModel = models[0].id;   // config에서 지운 모델이 남아있을 때

  $("#proj").innerHTML = projects
    .map((p) => `<option value="${esc(p.path)}">${esc(p.name)}</option>`).join("");
  // 등록 목록에 없는 폴더가 last_project로 저장돼 있으면 select.value가 ""가 되고,
  // 그 빈 값이 새 세션·편집기로 그대로 흘러간다. 안 먹으면 첫 항목으로 되돌린다.
  if (b.last_project) $("#proj").value = b.last_project;
  if (!$("#proj").value) $("#proj").value = projects[0].path;

  // --- 새 세션용 모델/강도 ---
  $("#modelPick").innerHTML = modelOptions(curModel);
  $("#modelPick").onchange = (e) => { curModel = e.target.value; syncEffortEnabled(); };
  $("#effortPick").innerHTML = effortButtons(curEffort);
  $("#effortPick").onclick = (e) => {
    const btn = e.target.closest("button"); if (!btn) return;
    curEffort = btn.dataset.e;
    [...$("#effortPick").children].forEach((c) => c.classList.toggle("on", c === btn));
  };
  syncEffortEnabled();

  // --- 권한 모드 (새 세션에만 적용 — 돌고 있는 세션은 TUI에서 Shift+Tab) ---
  $("#permPick").innerHTML = permModes
    .map((p) => `<option value="${esc(p.id)}" ${p.id === curPerm ? "selected" : ""}>
        ${esc(p.label)} · ${esc(p.id)}</option>`).join("");
  $("#permPick").onchange = (e) => { curPerm = e.target.value; syncPermNote(); };
  syncPermNote();

  // --- 지금 보고 있는 세션의 모델/강도 ---
  $("#paneModel").onchange = (e) => applyToPane({ model: e.target.value });
  $("#paneEffort").onclick = (e) => {
    const btn = e.target.closest("button"); if (!btn) return;
    applyToPane({ effort: btn.dataset.e });
  };

  $("#newBtn").onclick = () =>
    newPane({ cwd: $("#proj").value, model: curModel, effort: curEffort, perm: curPerm });
  $("#codeBtn").onclick = () => newEditorPane($("#proj").value);
  $("#chatBtn").onclick = () => newChatPane();
  $("#reloadBtn").onclick = loadSessions;
  $("#filter").oninput = renderSessions;

  $("#layoutPick").onclick = (e) => {
    const btn = e.target.closest("button"); if (!btn) return;
    setLayout(+btn.dataset.n);
  };

  document.addEventListener("keydown", (e) => {
    if (!e.ctrlKey) return;
    if (e.key >= "1" && e.key <= "9") {
      const p = order[+e.key - 1];
      if (p) { assign(p); e.preventDefault(); }
    }
  });

  await loadSessions();
  render();
  setInterval(pollUsage, 4000);

  $("#limits").onclick = refreshLimits;
  pollLimits();
  scheduleLimits();
}

// ============================== 구독 한도 ==============================
// 서버가 안 보이는 세션으로 /usage 화면을 긁어 캐시해둔다(10분마다).
// 처음엔 긁는 데 15초쯤 걸리므로 붙을 때까지만 자주 물어본다.
let limits = null;

async function pollLimits() {
  try {
    limits = await (await fetch("/api/limits")).json();
  } catch (_) {
    return;
  }
  paintLimits();
}

function scheduleLimits() {
  setTimeout(async () => {
    await pollLimits();
    scheduleLimits();
  }, limits && limits.ok ? 60000 : 6000);
}

async function refreshLimits() {
  $("#limits").classList.add("busy");
  try { await fetch("/api/limits?refresh=1"); } catch (_) {}
  for (const wait of [8000, 8000, 8000]) {
    await new Promise((r) => setTimeout(r, wait));
    await pollLimits();
  }
  $("#limits").classList.remove("busy");
}

function limitPart(name, d) {
  if (!d || typeof d.pct !== "number") return "";
  const c = d.pct >= 90 ? "hot" : d.pct >= 70 ? "mid" : "";
  return `<span class="lname">${name}</span>
    <span class="ubar ${c}"><i style="width:${Math.min(100, d.pct)}%"></i></span>
    <span class="lpct ${c}">${d.pct}%</span>`;
}

function paintLimits() {
  const el = $("#limits");
  const L = limits;
  if (!L || !L.ok || !(L.session || L.week)) { el.className = "limits hidden"; return; }
  el.className = "limits";
  el.innerHTML = [limitPart("5시간", L.session), limitPart("주간", L.week),
                  limitPart("Opus", L.opus)].filter(Boolean).join(`<span class="sep">·</span>`);
  const line = (n, d) => (d && typeof d.pct === "number")
    ? `${n} ${d.pct}%${d.resets ? ` · ${d.resets} 리셋` : ""}\n` : "";
  el.title = line("5시간", L.session) + line("주간", L.week) + line("Opus", L.opus)
    + (L.note ? L.note + "\n" : "")
    + `이 기기의 로컬 세션 기준 근사치 (다른 기기·claude.ai 사용분은 빠짐)\n`
    + `${L.age != null ? Math.floor(L.age / 60) + "분 전 확인 · " : ""}클릭하면 새로고침`;
}

// ============================== 컨텍스트 사용량 ==============================
// 서버가 세션 jsonl의 마지막 usage를 읽어준다. 첫 응답 전에는 잴 게 없어서 숨긴다.
async function pollUsage() {
  if (![...panes.values()].some((p) => p.kind === "term")) return;
  try {
    usage = await (await fetch("/api/usage")).json();
  } catch (_) {
    return;
  }
  paintUsage();
}

function paintUsage() {
  const el = $("#usage");
  const p = panes.get(slots[focusSlot]);
  const u = p && p.kind === "term" ? usage[p.id] : null;
  if (!u || !u.tokens) { el.className = "usage hidden"; return; }
  const pct = Math.min(100, u.pct);
  el.classList.remove("hidden");
  el.classList.toggle("mid", pct >= 70 && pct < 90);
  el.classList.toggle("hot", pct >= 90);
  el.querySelector("i").style.width = pct + "%";
  el.querySelector(".utext").textContent =
    `${u.pct}% · ${num(u.tokens)} / ${num(u.limit)}`;
  el.title = `이 세션이 물고 있는 컨텍스트 — ${num(u.tokens)} / ${num(u.limit)} 토큰`
           + `\n(마지막 응답 기준. 압축하면 다시 내려간다)`;
}

/** 강도 없는 모델(Haiku 4.5 등)이면 강도 칸을 흐리게 잠근다 */
function syncEffortEnabled() {
  const on = takesEffort(curModel);
  $("#effortPick").classList.toggle("dim", !on);
  $("#effortLbl").textContent = on ? "강도" : "강도 (이 모델은 없음)";
}

/** 위험한 모드면 경고를 띄운다. 돌고 있는 세션엔 적용 안 된다는 것도 여기서 알린다. */
function syncPermNote() {
  const p = permOf(curPerm);
  const el = $("#permNote");
  el.classList.toggle("warn", !!(p && p.warn));
  el.textContent = p && p.warn
    ? "확인 없이 파일을 고칩니다. 새 세션부터 적용."
    : "새 세션부터 적용 (실행 중인 세션은 Shift+Tab).";
}

async function applyToPane({ model, effort }) {
  const p = panes.get(slots[focusSlot]); if (!p) return;
  const r = await (await fetch(`/api/panes/${p.id}/model`, {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ model, effort }),
  })).json();
  if (model) { p.model = model; if (!takesEffort(model)) p.effort = null; }
  if (r.effort) p.effort = r.effort;
  render();
}

// ============================== 최근 작업 ==============================
async function loadSessions() {
  allSessions = await (await fetch("/api/sessions?limit=60")).json();
  renderSessions();
}

function renderSessions() {
  const q = $("#filter").value.trim().toLowerCase();
  const list = allSessions.filter((s) =>
    !q || s.title.toLowerCase().includes(q) || (s.project || "").toLowerCase().includes(q));
  if (!list.length) { $("#sessions").innerHTML = `<div class="empty">없음</div>`; return; }
  $("#sessions").innerHTML = list.map((s, i) => `
    <div class="item" data-i="${i}">
      <div class="t">${esc(s.title)}</div>
      <div class="m">
        <span class="p">${esc(s.project || "")}</span>
        <span>${ago(s.mtime)}</span>
        ${s.model ? `<span>${esc(s.model)}</span>` : ""}
      </div>
    </div>`).join("");
  $("#sessions").onclick = (e) => {
    const el = e.target.closest(".item"); if (!el) return;
    const s = list[+el.dataset.i];
    newPane({ cwd: s.cwd || $("#proj").value, model: curModel, effort: curEffort,
              perm: curPerm, resume: s.id, title: s.title });
  };
}

// ============================== 클립보드 ==============================
// WebView2 창 안에서는 navigator.clipboard 읽기가 권한 요청에 막혀 조용히 실패한다.
// 그래서 브라우저 API를 먼저 시도하고, 안 되면 서버(윈도우 클립보드)로 넘어간다.
async function clipRead() {
  try {
    const t = await navigator.clipboard.readText();
    if (t) return t;
  } catch (_) {}
  try {
    const d = await (await fetch("/api/clipboard")).json();
    return d.text || "";
  } catch (_) { return ""; }
}

async function clipWrite(text) {
  if (!text) return;
  try {
    await navigator.clipboard.writeText(text);
    return;
  } catch (_) {}
  try {
    await fetch("/api/clipboard", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ text }),
    });
  } catch (_) {}
}

// 터미널 붙여넣기/복사 키. true를 돌려주면 xterm이 평소대로 처리한다.
function termClipboardKeys(term) {
  term.attachCustomKeyEventHandler((e) => {
    if (e.type !== "keydown") return true;
    const k = (e.key || "").toLowerCase();
    // Ctrl+V / Ctrl+Shift+V / Shift+Insert = 붙여넣기
    if ((e.ctrlKey && k === "v") || (e.shiftKey && k === "insert")) {
      e.preventDefault();
      clipRead().then((t) => { if (t) term.paste(t); });   // 괄호 붙여넣기 처리는 xterm이 함
      return false;
    }
    // Ctrl+Shift+C = 선택 복사 (Ctrl+C는 그대로 중단 신호로 둔다)
    if (e.ctrlKey && e.shiftKey && k === "c") {
      e.preventDefault();
      clipWrite(term.getSelection());
      return false;
    }
    return true;
  });
}

// ============================== 패널 ==============================
async function newPane(opt) {
  const res = await fetch("/api/panes", {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ ...opt, cols: 120, rows: 30 }),
  });
  const d = await res.json();
  if (d.error) { alert(d.error); return; }

  const wrap = document.createElement("div");
  wrap.className = "term";
  const term = new Terminal(TERM_OPTS);
  const fit = new FitAddon.FitAddon();
  term.loadAddon(fit);
  term.open(wrap);
  try { term.loadAddon(new WebglAddon.WebglAddon()); } catch (_) {}
  termClipboardKeys(term);

  const pane = { ...d, kind: "term", term, fit, el: wrap, alive: true, ws: null,
                 title: opt.title || d.title, resumed: d.resumed };
  panes.set(d.id, pane);
  order.push(d.id);

  const ws = new WebSocket(`ws://${location.host}/ws/${d.id}`);
  pane.ws = ws;
  ws.onmessage = (ev) => {
    const m = JSON.parse(ev.data);
    if (m.t === "o") term.write(m.d);
  };
  ws.onclose = () => { pane.alive = false; render(); };
  term.onData((s) => { if (ws.readyState === 1) ws.send(JSON.stringify({ t: "i", d: s })); });

  new ResizeObserver(() => sizePane(pane)).observe(wrap);

  assign(d.id);
  setTimeout(loadSessions, 4000);   // 새 세션 파일이 목록에 잡히도록
}

// ============================== 코드 편집기 패널 ==============================
const CM_MODE = {
  py: "python", js: "javascript", jsx: "javascript", ts: "javascript",
  tsx: "javascript", json: { name: "javascript", json: true },
  html: "htmlmixed", htm: "htmlmixed", xml: "xml", css: "css",
  md: "markdown", sh: "shell", ps1: "shell", bat: "shell",
  c: "text/x-csrc", h: "text/x-csrc", cpp: "text/x-c++src",
  cs: "text/x-csharp", java: "text/x-java",
};
const modeOf = (name) => CM_MODE[(name.split(".").pop() || "").toLowerCase()] || null;

let _editSeq = 0;

function newEditorPane(cwd) {
  const id = "e" + ++_editSeq;
  const wrap = document.createElement("div");
  wrap.className = "edit-body";
  wrap.innerHTML = `<div class="edit-tree"></div><div class="edit-pane"></div>`;

  const cm = CodeMirror(wrap.querySelector(".edit-pane"), {
    value: "", theme: "material-darker", lineNumbers: true,
    autoCloseBrackets: true, matchBrackets: true, styleActiveLine: true,
    indentUnit: 4, tabSize: 4, lineWrapping: false,
  });

  const pane = { id, kind: "edit", title: "코드", cwd, el: wrap, cm, alive: true,
                 file: null, dirty: false, savedAt: "", treeAt: cwd };

  cm.on("change", () => {
    if (!pane.dirty && pane.file) { pane.dirty = true; render(); }
  });
  cm.setOption("extraKeys", {
    "Ctrl-S": () => saveFile(pane),
    "Cmd-S": () => saveFile(pane),
    "Ctrl-V": (c) => clipRead().then((t) => { if (t) c.replaceSelection(t); }),
    "Ctrl-C": (c) => clipWrite(c.getSelection()),
    "Ctrl-X": (c) => { clipWrite(c.getSelection()); c.replaceSelection(""); },
  });

  panes.set(id, pane);
  order.push(id);
  new ResizeObserver(() => sizePane(pane)).observe(wrap);
  loadTree(pane, cwd);
  assign(id);
  return pane;
}

// ============================== hcom 채팅 패널 ==============================
// hcom(hook-comms)이 쌓는 이벤트를 한 패널에 모아 보여준다. 서버가 ~/.hcom/hcom.db 를
// 읽어 주고(/api/hcom/state), 보내고 부르는 건 hcom CLI 를 태운다(/api/hcom/send·launch·resume).
// 터미널 패널과 달리 웹소켓이 아니라 2초 폴링이다 — hcom 이 DB 를 쓰는 쪽이라 굳이 밀 게 없다.
//
// 위쪽 줄: 왼쪽 = 참여자(켜짐/꺼짐), 오른쪽 = 불러올 수 있는 도구.
// 꺼진 칩·도구 칩은 누르거나 대화창으로 끌어다 놓으면 불러온다. 켜진 칩은 누르면 @멘션.
let _chatSeq = 0;
const LIVE = new Set(["active", "listening"]);          // listening = 대기 중이지만 살아 있음
const STATUS_KO = { active: "작업 중", listening: "대기 중", blocked: "승인 대기",
                    inactive: "꺼짐", unknown: "알 수 없음" };

function newChatPane() {
  const id = "h" + ++_chatSeq;
  const wrap = document.createElement("div");
  wrap.className = "chat-body";
  wrap.innerHTML = `
    <div class="chat-roster">
      <div class="roster-agents"></div>
      <div class="roster-tools"></div>
    </div>
    <div class="chat-log"></div>
    <div class="chat-err"></div>
    <div class="chat-input">
      <textarea rows="1" placeholder="모두에게 — Enter 전송, Shift+Enter 줄바꿈"></textarea>
      <button class="primary">보내기</button>
    </div>`;

  const pane = { id, kind: "chat", title: "에이전트 대화", el: wrap, alive: true,
                 lastId: 0, items: [], agents: [], stopped: [], tools: [],
                 sel: {}, toolSig: "", pending: {}, dropping: {},
                 me: "bigboss", err: "", timer: null };

  let _err = "";                          // 에러를 넣은 시각을 같이 기억한다
  Object.defineProperty(pane, "err", {
    get: () => _err, set: (v) => { _err = v || ""; pane.errAt = Date.now(); },
  });

  const ta = wrap.querySelector("textarea");
  const btn = wrap.querySelector(".chat-input button");
  const log = wrap.querySelector(".chat-log");
  const send = async () => {
    const text = ta.value.trim();
    if (!text) return;
    ta.value = ""; ta.style.height = "auto";
    btn.disabled = true;
    try {
      const r = await (await fetch("/api/hcom/send", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text }),
      })).json();
      if (r.error) { pane.err = r.error; paintChat(pane); }
      else { pane.err = ""; pollChat(pane); }
    } catch (ex) { pane.err = String(ex); paintChat(pane); }
    btn.disabled = false;
    ta.focus();
  };
  btn.onclick = send;
  ta.onkeydown = (e) => {
    if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); send(); }
  };
  ta.oninput = () => {                   // 입력줄이 내용만큼 자란다 (5줄까지)
    ta.style.height = "auto";
    ta.style.height = Math.min(ta.scrollHeight, 110) + "px";
  };

  const roster = wrap.querySelector(".chat-roster");
  roster.onclick = (e) => {
    const c = e.target.closest(".rchip");
    if (!c || c.disabled || c.dataset.dis) return;
    if (c.dataset.act === "mention") {   // 켜진 칩 → 입력줄에 @이름
      ta.value = (ta.value ? ta.value.replace(/\s*$/, " ") : "") + "@" + c.dataset.arg + " ";
      ta.focus();
    } else {
      summon(pane, c.dataset.act, c.dataset.arg);
    }
  };
  // 우클릭 = 내보내기. 켜져 있으면 hcom 에서 내보내고(세션은 남아 다시 깨울 수 있다),
  // 이미 꺼진 애면 목록에서만 지운다. 불러오기 도구 칩은 지울 게 없으니 그냥 둔다.
  roster.oncontextmenu = (e) => {
    const c = e.target.closest(".rchip");
    if (!c) return;
    const act = c.dataset.act;
    if (act !== "mention" && act !== "resume") return;
    e.preventDefault();
    dropAgent(pane, c.dataset.arg, act === "mention");
  };

  // 모델·강도 고르기. 모델을 바꾸면 그 모델이 못 받는 강도는 모델 기본값으로 돌린다
  wrap.querySelector(".roster-tools").onchange = (e) => {
    const sel = e.target.closest("select[data-tool]");
    if (!sel) return;
    const tool = sel.dataset.tool;
    const cur = pane.sel[tool] || (pane.sel[tool] = { model: "", effort: "" });
    cur[sel.dataset.k] = sel.value;
    if (sel.dataset.k === "model") {
      const t = pane.tools.find((x) => x.tool === tool);
      const m = t && (t.models || []).find((x) => x.id === cur.model);
      if (m && !m.efforts.includes(cur.effort)) cur.effort = m.default_effort || m.efforts[0] || "";
    }
    pane.toolSig = "";
    sel.blur();
    paintChat(pane);
  };

  // 끌어다 놓기: 우리 칩에서 시작한 드래그만 받는다 (파일·글자 드롭은 무시)
  roster.ondragstart = (e) => {
    const c = e.target.closest('.rchip[draggable="true"]');
    if (!c) { e.preventDefault(); return; }
    e.dataTransfer.setData("text/plain", c.dataset.act + ":" + c.dataset.arg);
    e.dataTransfer.effectAllowed = "copy";
    log.classList.add("drop-ready");
  };
  roster.ondragend = () => log.classList.remove("drop-ready", "drop-over");
  log.ondragover = (e) => {
    if (!log.classList.contains("drop-ready")) return;
    e.preventDefault();
    e.dataTransfer.dropEffect = "copy";
    log.classList.add("drop-over");
  };
  log.ondragleave = (e) => {
    if (!log.contains(e.relatedTarget)) log.classList.remove("drop-over");
  };
  log.ondrop = (e) => {
    if (!log.classList.contains("drop-ready")) return;
    e.preventDefault();
    log.classList.remove("drop-ready", "drop-over");
    const [act, ...rest] = (e.dataTransfer.getData("text/plain") || "").split(":");
    if (act === "launch" || act === "resume") summon(pane, act, rest.join(":"));
  };

  panes.set(id, pane);
  order.push(id);
  pollChat(pane);
  pane.timer = setInterval(() => pollChat(pane), 2000);
  assign(id);
  return pane;
}

async function summon(pane, act, arg) {
  const key = act + ":" + arg;
  if (pane.pending[key]) return;         // 연타로 두 마리 부르지 않게
  pane.pending[key] = Date.now();
  pane.err = "";
  paintChat(pane);
  try {
    const pick = pane.sel[arg] || {};
    const body = act === "launch"
      ? { tool: arg, cwd: $("#proj").value, model: pick.model || "", effort: pick.effort || "" }
      : { name: arg };
    const r = await (await fetch(`/api/hcom/${act}`, {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    })).json();
    if (r.error) { pane.err = r.error; delete pane.pending[key]; }
  } catch (ex) { pane.err = String(ex); delete pane.pending[key]; }
  paintChat(pane);
}

// 우클릭으로 내보내기. live=켜져 있는 애(hcom kill) / 아니면 목록에서만 지우기.
async function dropAgent(pane, name, live) {
  if (pane.dropping[name]) return;
  pane.dropping[name] = true;
  pane.err = "";
  paintChat(pane);
  try {
    const r = await (await fetch(live ? "/api/hcom/kill" : "/api/hcom/hide", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name }),
    })).json();
    if (r.error) pane.err = r.error;
    else if (live) {
      pane.err = `${name} 내보냈어 — 꺼짐 칩을 누르면 하던 자리에서 다시 깨운다`;
      closeAgentPane(name);
    } else {
      pane.err = `${name} 목록에서 지웠어`;
    }
  } catch (ex) { pane.err = String(ex); }
  delete pane.dropping[name];
  pollChat(pane);
}

// 내보낸 애가 쓰던 터미널 탭도 같이 닫는다 (죽은 창만 남으면 그게 더 불편하다)
function closeAgentPane(name) {
  const ids = [];
  for (const [id, p] of panes)
    if (p.agent && (p.title || "").split(" · ")[0] === name) ids.push(id);
  for (const id of ids) closePane(id);
}

// 부르는 중 표시는 실제로 방에 들어오면 지운다. 안 들어오면 40초 뒤 포기.
function settlePending(pane) {
  const now = Date.now();
  for (const [key, at] of Object.entries(pane.pending)) {
    const [act, arg] = key.split(":");
    const arrived = act === "launch"
      ? pane.agents.some((a) => a.tool === arg && a.created * 1000 >= at - 5000)
      : pane.agents.some((a) => a.name === arg && LIVE.has(a.status));
    if (arrived) delete pane.pending[key];
    else if (now - at > 40000) {
      delete pane.pending[key];
      pane.err = `${arg} 이(가) 40초 안에 안 떴어 — 새로 생긴 터미널 탭이 있는지 보고, 없으면 ~/.hcom/helm_spool/helm_open.log 확인`;
    }
  }
}

// hcom 이 "이 스크립트를 터미널에서 돌려줘"라고 남긴 걸 HELM 터미널 탭으로 연다.
// 대화창을 가리지 않게: 한 칸이면 두 칸으로 벌리고, 대화창이 없는 칸에 올린다.
async function openAgentPane(chat, sp) {
  if (layout === 1) setLayout(2);
  const chatSlot = slots.indexOf(chat.id);
  let target = slots.findIndex((x, i) => i !== chatSlot && !x);
  if (target < 0) target = slots.findIndex((x, i) => i !== chatSlot);
  if (target >= 0) focusSlot = target;
  await newPane({ hcom_script: sp.script, cwd: sp.cwd || undefined,
                  title: [sp.name, sp.tool].filter(Boolean).join(" · ") || "에이전트",
                  model: sp.model || sp.tool || "agent", effort: sp.effort || null });
}

async function pollChat(pane) {
  if (!pane.alive) return;
  try {
    const r = await (await fetch(`/api/hcom/state?after=${pane.lastId}`)).json();
    if (!r.ok) { pane.err = r.error || "hcom 을 읽을 수 없어"; paintChat(pane); return; }
    if (pane.err && Date.now() - pane.errAt > 8000) pane.err = "";
    pane.me = r.me || pane.me;
    const sig = (xs) => xs.map((a) => a.name + a.status).join("|");
    const before = sig(pane.agents);
    pane.agents = (r.agents || []).filter((a) => a.name !== pane.me);   // 나는 참여자에서 뺀다
    pane.stopped = r.stopped || [];
    pane.tools = r.tools || [];
    for (const t of pane.tools)                 // 처음 보는 도구는 서버가 고른 값(마지막 선택 / codex 기본)으로
      if (!pane.sel[t.tool] && t.choice) pane.sel[t.tool] = { ...t.choice };
    for (const sp of r.spawns || []) openAgentPane(pane, sp);
    settlePending(pane);
    if (r.messages && r.messages.length) {
      pane.items.push(...r.messages);
      pane.lastId = r.last_id;
      if (pane.items.length > 500) pane.items = pane.items.slice(-500);
    }
    if (before !== sig(pane.agents)) render();   // 슬롯 헤더의 "N명 활성"까지
    else paintChat(pane);
  } catch (ex) {
    pane.err = String(ex);
    paintChat(pane);
  }
}

function paintChat(pane) {
  const log = pane.el.querySelector(".chat-log");
  if (!log) return;
  const stuck = log.scrollTop + log.clientHeight >= log.scrollHeight - 40;

  log.innerHTML = pane.items.map((m) => {
    if (m.kind === "life")
      return `<div class="chat-sys">${esc(m.from)} ${m.text === "created" || m.text === "ready" ? "들어옴" : "나감"}</div>`;
    const mine = m.from === pane.me;
    const to = (m.to && m.to.length) ? m.to.join(", ")
             : (m.scope === "broadcast" ? "전체" : "");
    return `<div class="chat-row ${mine ? "mine" : ""}">
        <div class="chat-msg">
          <div class="chat-who">${esc(m.from)}${to ? ` <span class="chat-to">→ ${esc(to)}</span>` : ""}</div>
          <div class="chat-text">${esc(m.text)}</div>
        </div></div>`;
  }).join("") || `<div class="hollow">아직 대화가 없어 — 위쪽 <b>+ 도구</b>를 누르거나 여기로 끌어다 놔서 에이전트를 불러와</div>`;
  if (stuck) log.scrollTop = log.scrollHeight;

  const ready = new Set(pane.tools.filter((t) => t.ready).map((t) => t.tool));
  // soft = 못 누르게는 하되 disabled 는 안 건다. disabled 버튼은 우클릭도 안 먹어서
  // 정작 지우고 싶은 (깨울 수 없는) 칩을 못 지운다.
  const chip = ({ cls, act, arg, drag, disabled, soft, title, body }) =>
    `<button class="rchip ${cls}${disabled && soft ? " dis" : ""}" data-act="${act}" data-arg="${esc(arg)}"
       ${drag && !disabled ? 'draggable="true"' : ""}
       ${disabled ? (soft ? 'data-dis="1"' : "disabled") : ""}
       title="${esc(title)}">${body}</button>`;
  const face = (name, tool, note) =>
    `<span class="dot"></span><span class="rname">${esc(name)}</span>` +
    `<span class="rtool">${esc(note || tool || "")}</span>`;

  // 왼쪽: 지금 방에 있는 애들 → 켜짐/승인대기/꺼짐, 그 뒤로 멈춘 애들
  const chips = pane.agents.map((a) => {
    const live = LIVE.has(a.status);
    const waking = pane.pending["resume:" + a.name];
    const going = pane.dropping[a.name];
    if (live || a.status === "blocked")
      return chip({ cls: (live ? "on" : "warn") + (going ? " wait" : ""), act: "mention", arg: a.name,
                    disabled: going, soft: true,
                    title: `${STATUS_KO[a.status] || a.status} · 눌러서 @멘션 · 우클릭하면 내보낸다`,
                    body: face(a.name, a.tool, going ? "내보내는 중…"
                                     : a.status === "blocked" ? "승인 대기" : a.tool) });
    const can = ready.has(a.tool);
    return chip({ cls: "off" + (waking || going ? " wait" : ""), act: "resume", arg: a.name, drag: can,
                  disabled: !can || waking || going, soft: true,
                  title: (can ? "꺼짐 · 누르거나 끌어다 놓으면 깨운다" : `${a.tool} 훅이 없어 못 깨움`)
                         + " · 우클릭하면 목록에서 지운다",
                  body: face(a.name, a.tool, going ? "지우는 중…" : waking ? "깨우는 중…" : "") });
  });
  for (const a of pane.stopped) {
    const waking = pane.pending["resume:" + a.name];
    const going = pane.dropping[a.name];
    const can = a.resumable && ready.has(a.tool);
    chips.push(chip({ cls: "off" + (waking || going ? " wait" : ""), act: "resume", arg: a.name, drag: can,
                      disabled: !can || waking || going, soft: true,
                      title: (can ? "멈춤 · 누르거나 끌어다 놓으면 깨운다"
                           : !a.resumable ? "되살릴 세션이 없어" : `${a.tool} 훅이 없어 못 깨움`)
                             + " · 우클릭하면 목록에서 지운다",
                      body: face(a.name, a.tool, going ? "지우는 중…" : waking ? "깨우는 중…" : "") }));
  }
  pane.el.querySelector(".roster-agents").innerHTML =
    chips.join("") || `<span class="rempty">참여자 없음</span>`;

  // 오른쪽: 새로 불러올 도구 + 모델·강도.
  // 2초마다 다시 그리면 열어 둔 드롭다운이 닫힌다 → 바뀐 게 있을 때만, 고르는 중이 아닐 때만 그린다
  const box = pane.el.querySelector(".roster-tools");
  const sig = JSON.stringify([pane.tools, Object.keys(pane.pending), pane.sel, $("#proj") && $("#proj").value]);
  const picking = box.contains(document.activeElement) && document.activeElement.tagName === "SELECT";
  if (sig !== pane.toolSig && !picking) {
    pane.toolSig = sig;
    const where = shorten($("#proj") ? $("#proj").value : "", 40);
    box.innerHTML = pane.tools.length
      ? `<span class="rlbl">불러오기</span>` + pane.tools.map((t) => {
          const busy = pane.pending["launch:" + t.tool];
          const pick = pane.sel[t.tool] || {};
          const models = t.ready ? (t.models || []) : [];
          const m = models.find((x) => x.id === pick.model);
          const opt = (v, label, on) => `<option value="${esc(v)}" ${on ? "selected" : ""}>${esc(label)}</option>`;
          const pickers = models.length
            ? `<select class="rsel" data-tool="${esc(t.tool)}" data-k="model" title="모델" ${busy ? "disabled" : ""}>
                 ${models.map((x) => opt(x.id, x.label, x.id === pick.model)).join("")}</select>` +
              (m && m.efforts.length
                ? `<select class="rsel eff" data-tool="${esc(t.tool)}" data-k="effort" title="강도" ${busy ? "disabled" : ""}>
                     ${m.efforts.map((e) => opt(e, e, e === pick.effort)).join("")}</select>`
                : "")
            : "";
          const what = [m && m.label, pick.effort].filter(Boolean).join(" · ");
          return `<span class="tgroup ${t.ready ? "" : "dis"}">` + chip({
              cls: "tool" + (busy ? " wait" : ""), act: "launch", arg: t.tool,
              drag: t.ready, disabled: !t.ready || busy,
              title: t.ready ? `${what ? what + " 로 " : ""}새로 부른다 · 누르거나 대화창으로 끌어다 놓기 · 시작 폴더: ${where}`
                             : `훅이 없어 불러와도 대화를 못 받아 (hcom hooks add ${t.tool})`,
              body: busy ? `<span class="rname">${esc(t.tool)} 부르는 중…</span>`
                         : `<span class="plus">+</span><span class="rname">${esc(t.tool)}</span>` })
            + pickers + `</span>`;
        }).join("")
      : `<span class="rempty">불러올 도구 없음</span>`;
  }

  const eb = pane.el.querySelector(".chat-err");
  eb.textContent = pane.err || "";
  eb.classList.toggle("on", !!pane.err);
}

async function loadTree(pane, path) {
  const r = await (await fetch(`/api/tree?path=${encodeURIComponent(path)}`)).json();
  if (r.error) { alert(r.error); return; }
  pane.treeAt = r.path;
  const el = pane.el.querySelector(".edit-tree");
  el.innerHTML =
    (r.parent ? `<div class="tnode d" data-up="${esc(r.parent)}">.. 상위</div>` : "") +
    r.entries.map((e) =>
      `<div class="tnode ${e.dir ? "d" : ""} ${pane.file === e.path ? "sel" : ""}"
            data-${e.dir ? "dir" : "file"}="${esc(e.path)}"
            title="${esc(e.name)}">${e.dir ? "▸ " : ""}${esc(e.name)}</div>`).join("");
  el.onclick = (ev) => {
    const n = ev.target.closest(".tnode"); if (!n) return;
    if (n.dataset.up || n.dataset.dir) loadTree(pane, n.dataset.up || n.dataset.dir);
    else openFile(pane, n.dataset.file);
  };
}

async function openFile(pane, path) {
  if (pane.dirty && !confirm("저장 안 된 변경이 있어. 버리고 열까?")) return;
  const r = await (await fetch(`/api/file?path=${encodeURIComponent(path)}`)).json();
  if (r.error) { alert(r.error); return; }
  pane.file = r.path;
  pane.title = r.name;
  pane.cm.setOption("mode", modeOf(r.name));
  pane.cm.setValue(r.content);
  pane.cm.clearHistory();
  pane.dirty = false;
  pane.savedAt = "";
  loadTree(pane, pane.treeAt);
  render();
  setTimeout(() => pane.cm.refresh(), 0);
}

async function saveFile(pane) {
  if (!pane.file) return;
  const r = await (await fetch("/api/file", {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ path: pane.file, content: pane.cm.getValue() }),
  })).json();
  if (r.error) { alert(r.error); return; }
  pane.dirty = false;
  pane.savedAt = r.saved;
  render();
}

function sizePane(p) {
  if (p.kind === "chat") return;
  if (p.kind === "edit") { try { p.cm.refresh(); } catch (_) {} return; }
  try {
    p.fit.fit();
    if (p.ws && p.ws.readyState === 1)
      p.ws.send(JSON.stringify({ t: "r", cols: p.term.cols, rows: p.term.rows }));
  } catch (_) {}
}

async function closePane(id) {
  const p = panes.get(id); if (!p) return;
  p.alive = false;
  if (p.timer) { clearInterval(p.timer); p.timer = null; }
  if (p.kind === "chat") {
    // 붙잡을 프로세스가 없다 — 폴링만 끄면 끝
  } else if (p.kind === "edit") {
    if (p.dirty && !confirm("저장 안 된 변경이 있어. 닫을까?")) return;
  } else {
    // 서버에 먼저 알리고 소켓은 서버가 닫게 둔다 (여기서 먼저 닫으면 프레임이 깨진다)
    await fetch(`/api/panes/${id}`, { method: "DELETE" });
    p.term.dispose();
  }
  panes.delete(id);
  order = order.filter((x) => x !== id);
  slots = slots.map((s) => (s === id ? null : s));
  render();
}

function assign(id) {          // 포커스된 슬롯에 이 패널을 올린다
  const already = slots.indexOf(id);
  if (already >= 0) { focusSlot = already; render(); return; }
  slots[focusSlot] = id;
  render();
}

function setLayout(n) {
  layout = n;
  const next = slots.slice(0, n);
  while (next.length < n) next.push(null);
  // 빈 슬롯은 아직 안 걸린 패널로 자동으로 메운다
  const used = new Set(next.filter(Boolean));
  for (let i = 0; i < n; i++)
    if (!next[i]) next[i] = order.find((o) => !used.has(o) && (used.add(o), true)) || null;
  slots = next;
  if (focusSlot >= n) focusSlot = 0;
  [...$("#layoutPick").children].forEach((c) => c.classList.toggle("on", +c.dataset.n === n));
  render();
}

// ============================== 그리기 ==============================
function render() {
  $("#tabs").innerHTML = order.map((id, i) => {
    const p = panes.get(id);
    const mark = p.kind === "edit" ? `<span>✎</span>`
                : p.kind === "chat" ? `<span>💬</span>` : `<span class="dot"></span>`;
    return `<button class="tab ${slots.includes(id) ? "on" : ""} ${p.alive ? "" : "off"}" data-id="${id}">
      ${mark}<span>${i + 1}. ${esc(shorten(p.title))}${p.dirty ? " •" : ""}</span>
      <span class="x" data-x="${id}">×</span></button>`;
  }).join("");
  $("#tabs").onclick = (e) => {
    const x = e.target.closest(".x");
    if (x) { closePane(x.dataset.x); return; }
    const t = e.target.closest(".tab");
    if (t) assign(t.dataset.id);
  };

  const grid = $("#grid");
  grid.className = "n" + layout;
  grid.innerHTML = "";
  slots.forEach((id, i) => {
    const slot = document.createElement("div");
    slot.className = "slot" + (i === focusSlot ? " focus" : "");
    slot.onmousedown = () => { if (focusSlot !== i) { focusSlot = i; render(); } };
    const p = id && panes.get(id);
    if (p && p.kind === "chat") {
      const live = p.agents.filter((a) => LIVE.has(a.status)).length;
      slot.innerHTML = `<div class="head">
          <span class="nm">에이전트 대화</span>
          <span class="chip">hcom</span>
          <span class="chip">${live}명 활성</span>
          <span class="chip">나 = ${esc(p.me)}</span>
        </div>`;
      slot.appendChild(p.el);
      setTimeout(() => paintChat(p), 0);
    } else if (p && p.kind === "edit") {
      slot.innerHTML = `<div class="head">
          <span class="nm">${esc(p.file ? p.title : "코드 편집기 — 왼쪽에서 파일 선택")}</span>
          ${p.dirty ? `<span class="chip dirty">저장 안 됨</span>` : ""}
          ${p.savedAt && !p.dirty ? `<span class="chip saved">저장됨 ${esc(p.savedAt)}</span>` : ""}
          <span class="chip">Ctrl+S</span>
          <span class="chip">${esc(shorten(p.treeAt, 30))}</span>
        </div>`;
      slot.appendChild(p.el);
      setTimeout(() => sizePane(p), 0);
    } else if (p) {
      const ml = (modelOf(p.model) || {}).label || p.model;
      slot.innerHTML = `<div class="head">
          <span class="nm">${esc(p.title)}</span>
          <span class="chip">${esc(ml)}${p.effort ? " · " + esc(p.effort) : ""}</span>
          ${p.perm && p.perm !== "manual"
            ? `<span class="chip ${(permOf(p.perm)||{}).warn ? "warn" : ""}">${esc((permOf(p.perm)||{}).label || p.perm)}</span>` : ""}
          ${p.resumed ? `<span class="chip">이어감</span>` : ""}
          ${p.agent ? `<span class="chip">hcom 에이전트</span>` : ""}
          <span class="chip">${esc(shorten(p.cwd, 28))}</span>
        </div>`;
      slot.appendChild(p.el);
      setTimeout(() => sizePane(p), 0);
    } else {
      slot.innerHTML = `<div class="hollow">비어 있음 — 왼쪽에서 세션을 시작하거나 탭을 눌러 올려놔</div>`;
    }
    grid.appendChild(slot);
  });

  paintUsage();
  const fp = panes.get(slots[focusSlot]);
  const isTerm = fp && fp.kind === "term" && !fp.agent;   // hcom 에이전트 탭은 claude 가 아니다
  $("#paneModel").classList.toggle("hidden", !isTerm);
  $("#paneEffort").classList.toggle("hidden", !isTerm || !takesEffort(fp.model));
  if (isTerm) {
    $("#paneModel").innerHTML = modelOptions(fp.model);
    $("#paneEffort").innerHTML = effortButtons(fp.effort);
    setTimeout(() => fp.term.focus(), 0);
  }
}

// ============================== 유틸 ==============================
function esc(s) {
  return String(s ?? "").replace(/[&<>"]/g, (c) =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
}
function shorten(s, n = 22) {
  s = String(s ?? "");
  return s.length > n ? s.slice(0, n - 1) + "…" : s;
}
function num(n) {
  return Number(n || 0).toLocaleString("en-US");
}
function ago(ts) {
  const d = Date.now() / 1000 - ts;
  if (d < 3600) return `${Math.max(1, Math.floor(d / 60))}분 전`;
  if (d < 86400) return `${Math.floor(d / 3600)}시간 전`;
  return `${Math.floor(d / 86400)}일 전`;
}

// 웹폰트가 로드되기 전에 터미널을 만들면 글자 폭을 잘못 재서 줄이 어긋난다.
(document.fonts ? document.fonts.load('13.5px "JBM"').then(() => document.fonts.ready)
                : Promise.resolve()).then(boot, boot);
